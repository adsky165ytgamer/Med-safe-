rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net - Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidNonEmptyString(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    function isValidOptionalString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isValidStringList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || arr[0] is string);
    }

    function isValidScheduleList(arr, maxItems) {
      return arr is list && arr.size() <= maxItems && (arr.size() == 0 || arr[0] is map);
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.selectedLanguage is string
        && data.selectedLanguage.size() >= 2
        && data.selectedLanguage.size() <= 50
        && data.textSize is string
        && data.textSize in ['normal', 'large', 'jumbo']
        && data.highContrast is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMedicineFields(data) {
      return isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidNonEmptyString(data.brandName, 200)
        && isValidNonEmptyString(data.genericName, 200)
        && isValidNonEmptyString(data.purpose, 1000)
        && isValidNonEmptyString(data.dosage, 500)
        && isValidNonEmptyString(data.timing, 500)
        && isValidNonEmptyString(data.warning, 1500)
        && isValidNonEmptyString(data.foodInstructions, 1000)
        && isValidNonEmptyString(data.missedDose, 1000)
        && isValidNonEmptyString(data.storage, 500)
        && isValidNonEmptyString(data.audioSpeechText, 1500)
        && isValidStringList(data.keyBulletPoints, 10)
        && isValidScheduleList(data.schedule, 10)
        && data.languageUsed is string
        && data.languageUsed.size() >= 2
        && data.languageUsed.size() <= 50
        && data.createdAt is timestamp;
    }

    function isValidCabinetMedicine(data) {
      return isValidMedicineFields(data)
        && data.updatedAt is timestamp;
    }

    function isValidScanHistoryItem(data) {
      return isValidMedicineFields(data);
    }

    function isValidPillTask(data) {
      return isValidId(data.userId)
        && data.userId == request.auth.uid
        && isValidNonEmptyString(data.medicineId, 128)
        && isValidNonEmptyString(data.medicineName, 200)
        && isValidNonEmptyString(data.timeSlot, 40)
        && isValidNonEmptyString(data.time, 40)
        && isValidNonEmptyString(data.label, 100)
        && isValidNonEmptyString(data.instruction, 500)
        && data.taken is bool
        && (!('takenAt' in data) || isValidOptionalString(data.takenAt, 40))
        && data.dateKey is string
        && data.dateKey.size() <= 20
        && data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Master Gate helper for subcollections
    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.userId == request.auth.uid;
    }

    // --- Collection: /users/{userId} ---
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && incoming().keys().hasAll(['userId', 'selectedLanguage', 'textSize', 'highContrast', 'createdAt', 'updatedAt'])
        && incoming().keys().hasOnly(['userId', 'selectedLanguage', 'textSize', 'highContrast', 'createdAt', 'updatedAt'])
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['selectedLanguage', 'textSize', 'highContrast', 'updatedAt']);

      allow delete: if isVerifiedUser() && isValidId(userId) && isOwner(userId);

      // --- Subcollection: /users/{userId}/cabinet/{medicineId} ---
      match /cabinet/{medicineId} {
        allow get: if isValidId(userId) && isValidId(medicineId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(medicineId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'userId', 'brandName', 'genericName', 'purpose', 'dosage',
            'timing', 'warning', 'foodInstructions', 'missedDose', 'storage',
            'audioSpeechText', 'keyBulletPoints', 'schedule', 'languageUsed',
            'createdAt', 'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'userId', 'brandName', 'genericName', 'purpose', 'dosage',
            'timing', 'warning', 'foodInstructions', 'missedDose', 'storage',
            'audioSpeechText', 'keyBulletPoints', 'schedule', 'languageUsed',
            'createdAt', 'updatedAt'
          ])
          && isValidCabinetMedicine(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(medicineId)
          && isOwner(userId)
          && isValidCabinetMedicine(incoming())
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentUserExists(userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'brandName', 'genericName', 'purpose', 'dosage',
            'timing', 'warning', 'foodInstructions', 'missedDose', 'storage',
            'audioSpeechText', 'keyBulletPoints', 'schedule', 'languageUsed', 'updatedAt'
          ]);

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(medicineId) && isOwner(userId);
      }

      // --- Subcollection: /users/{userId}/pillTasks/{taskId} ---
      match /pillTasks/{taskId} {
        allow get: if isValidId(userId) && isValidId(taskId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'userId', 'medicineId', 'medicineName', 'timeSlot', 'time',
            'label', 'instruction', 'taken', 'dateKey', 'createdAt', 'updatedAt'
          ])
          && incoming().keys().hasOnly([
            'userId', 'medicineId', 'medicineName', 'timeSlot', 'time',
            'label', 'instruction', 'taken', 'takenAt', 'dateKey', 'createdAt', 'updatedAt'
          ])
          && isValidPillTask(incoming())
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && parentUserExists(userId);

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(taskId)
          && isOwner(userId)
          && isValidPillTask(incoming())
          && incoming().userId == existing().userId
          && incoming().medicineId == existing().medicineId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && parentUserExists(userId)
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['taken', 'takenAt', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['taken', 'updatedAt'])
          );

        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(taskId) && isOwner(userId);
      }

      // --- Subcollection: /users/{userId}/scanHistory/{scanId} ---
      match /scanHistory/{scanId} {
        allow get: if isValidId(userId) && isValidId(scanId) && isOwner(userId);
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(scanId)
          && isOwner(userId)
          && incoming().keys().hasAll([
            'userId', 'brandName', 'genericName', 'purpose', 'dosage',
            'timing', 'warning', 'foodInstructions', 'missedDose', 'storage',
            'audioSpeechText', 'keyBulletPoints', 'schedule', 'languageUsed',
            'createdAt'
          ])
          && incoming().keys().hasOnly([
            'userId', 'brandName', 'genericName', 'purpose', 'dosage',
            'timing', 'warning', 'foodInstructions', 'missedDose', 'storage',
            'audioSpeechText', 'keyBulletPoints', 'schedule', 'languageUsed',
            'createdAt'
          ])
          && isValidScanHistoryItem(incoming())
          && incoming().createdAt == request.time
          && parentUserExists(userId);

        allow update: if false;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(scanId) && isOwner(userId);
      }
    }
  }
}
